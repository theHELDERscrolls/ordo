PORT=3000
# Local dev DB (run once):
#   docker run -d --name ordo-mongo -p 27017:27017 -v ordo-mongo-data:/data/db mongo
MONGODB_URI=mongodb://localhost:27017/ordo
# Secret used to sign access JWTs. Use a long random string.
JWT_SECRET=
# Origins allowed to call the API, comma-separated. Leave unset to allow any,
# which is what local development wants; production names the deployed frontend.
CORS_ORIGIN=
